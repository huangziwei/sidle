.claude
.DS_Store

ref/
books/
bench
scripts/
/target
sidle/desktop/gen/

artifacts/

# Per-install secret + binary. `device/server.conf.example` is the template;
# real values fill in `etc/server.conf` at install time and stay out of git.
device/extensions/sidle/etc/server.conf
device/extensions/sidle/bin/sidle
device/extensions/sidle/bin/sidle.build-ts
device/extensions/bokai/bin/bokai
device/extensions/bokai/bin/bokai-armsf

# build.sh staging: the sidle-server sidecar and on-device resources copied here
# for `cargo tauri build` to fold into the bundle. Regenerated each build; never committed.
sidle/desktop/binaries/
sidle/desktop/resources/

# Per-machine vendored 3rd-party binaries (not source). Previously the
# bblanchon libpdfium cache; the PDF engine is now macOS PDFKit (no bundled
# dylib), so this is only kept ignored for any stale cache from older builds.
vendor/
# CI packaging output (the release zip + its checksum). Made by the release
# workflow from device/extensions/bokai; never committed.
dist/
